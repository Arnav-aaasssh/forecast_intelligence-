# =========================================================
# Forecast Review & Decision Support System - Environment Configuration
# =========================================================
# Copy this file to .env and replace the placeholder values.

# ----------------------------------------------------------
# Provider Selection
# ----------------------------------------------------------
# Switch the active LLM provider here. No code changes needed.
# Options: gemini | company
LLM_PROVIDER=gemini

# ----------------------------------------------------------
# Google Gemini Configuration
# ----------------------------------------------------------
# REQUIRED when LLM_PROVIDER=gemini
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides
GEMINI_MODEL=gemini-2.5-pro
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_SECONDS=60

# ----------------------------------------------------------
# Company Internal LLM Configuration
# ----------------------------------------------------------
# REQUIRED when LLM_PROVIDER=company
# Replace COMPANY_ENDPOINT with the actual internal URL.
COMPANY_LLM_ENDPOINT=COMPANY_ENDPOINT

# Optional overrides
COMPANY_MODEL=llama3.1:8b
COMPANY_TEMPERATURE=0.25
COMPANY_TIMEOUT_SECONDS=120
